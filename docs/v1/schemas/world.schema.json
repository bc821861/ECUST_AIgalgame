{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galgame.local/schemas/world.schema.json",
  "title": "WorldConfig",
  "description": "content/world/world.json：地图 + 时钟定义 + 地点标签。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "start", "map", "phases", "actionsPerPhase"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "start": {
      "type": "object",
      "additionalProperties": false,
      "required": ["day", "phase", "location"],
      "properties": {
        "day": { "type": "integer", "minimum": 1 },
        "phase": { "type": "string" },
        "location": { "type": "string" }
      }
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nodes"],
      "properties": {
        "id": { "type": "string" },
        "nodes": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "desc", "neighbors", "tags", "bg"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
              "name": { "type": "string", "maxLength": 16 },
              "desc": { "type": "string", "maxLength": 80 },
              "neighbors": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["室内", "室外", "私密", "人多", "上课", "可交易", "僻静", "危险"]
                }
              },
              "bg": { "type": "string" },
              "npcs": { "type": "array", "items": { "type": "string" }, "description": "常驻 NPC（可被 schedule 覆盖）" }
            }
          }
        }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "enum": ["morning", "forenoon", "noon", "afternoon", "evening", "night"] }
    },
    "actionsPerPhase": { "type": "integer", "minimum": 1, "maximum": 6 },
    "weather": { "type": "string", "maxLength": 10 }
  }
}
