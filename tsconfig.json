{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@galgame/shared": ["packages/shared/src/index.ts"],
      "@galgame/shared/*": ["packages/shared/src/*"],
      "@galgame/engine": ["packages/engine/src/index.ts"],
      "@galgame/engine/*": ["packages/engine/src/*"],
      "@galgame/llm": ["packages/llm/src/index.ts"],
      "@galgame/llm/*": ["packages/llm/src/*"],
      "@galgame/testkit": ["packages/testkit/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*", "apps/*/src/**/*", "scripts/**/*", "vitest.config.ts", "apps/web/vite.config.ts"]
}
