# 测试期用免费端点（ecust）。真实 key 只放本地 .env，进 .gitignore。
GALGAME_LLM_BASE_URL=https://ai.ecustcic.com/api/v1
GALGAME_LLM_MODEL=deepseek-v4.1-flash
GALGAME_LLM_API_KEY=sk-xxxxxxxx
GALGAME_PORT=8787

# 审核器：必须是与叙事模型不同家族的强模型（DeepSeek 系容易被同一套破甲提示词带走）。
# 三项必须独立配置（不继承上面 LLM_*，也不写死模型名）；缺任意一项 → NoopAudit（放行）+ 启动告警，只适合本地开发。
# GALGAME_AUDIT_BASE_URL=https://ai.ecustcic.com/api/v1
# GALGAME_AUDIT_MODEL=<另一个家族的强模型，名字只写在本地 .env>
# GALGAME_AUDIT_API_KEY=sk-xxxxxxxx
