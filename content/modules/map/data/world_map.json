        {
          "id": "dlg_library_stacks",
          "npcId": "npc_lin",
          "title": "问问过刊室",
          "lines": [
            "林静把借阅章按回印泥里，没有抬头：「过刊室在里头，登记了才能进。」",
            "她停了一下，又说：「最近三期合订本都被人动过。你要借，别借那几本。」",
            "盖章声重新响起来，像是刚才那句话没说过。"
          ]
        }
      ]
    },
